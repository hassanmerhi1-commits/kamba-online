{
  "name": "kamba-online-desktop",
  "productName": "Kamba Online",
  "version": "1.1.0",
  "description": "Kamba Online - shop and admin on this computer",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare-app": "node scripts/build-all.mjs",
    "dist": "node scripts/build-all.mjs && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.kamba.online.desktop",
    "productName": "Kamba Online",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server/src",
        "to": "server/src"
      },
      {
        "from": "../server/package.json",
        "to": "server/package.json"
      },
      {
        "from": "../mobile/dist",
        "to": "customer"
      },
      {
        "from": "../admin/dist",
        "to": "admin"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hassanmerhi1-commits",
        "repo": "kamba-online",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kamba Online"
    }
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
